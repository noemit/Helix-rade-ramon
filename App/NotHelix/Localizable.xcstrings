            "value" : "Introducir rexistro"
          }
        }
      }
    },
    "Every change — records and design — is logged. You can undo step by step, or put an old version of a record back." : {
      "extractionState" : "manual",
      "localizations" : {
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cambio — rexistros e deseño — queda rexistrado. Podes desfacer paso a paso ou recuperar unha versión anterior dun rexistro."
          }
        }
      }
    },
    "Every record you enter, replace or delete is logged here and can be restored." : {
      "extractionState" : "manual",
      "localizations" : {
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada rexistro que introduces, substitúes ou eliminas queda anotado aquí e pódese restaurar."
          }
        }
      }
    },
    "Everything inside repeats once per record in list views. Drag fields into it; move it to move its contents." : {
      "extractionState" : "manual",
      "localizations" : {
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo o que está dentro repítese unha vez por rexistro nas vistas de lista. Arrastra campos dentro; móveo para mover o seu contido."
          }
        }
      }
    },
    "Everything that belongs to one relation, as icons: fields, abaci, templates, views, queries and indexes. Arrange them however you like." : {
      "extractionState" : "manual",
      "localizations" : {
        "gl" : {
